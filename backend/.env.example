# Copy to backend/.env (git-ignored). Only needed for the AI summarizers.
# (The web app's Supabase and email variables live in the root .env.example.)

# --summarizer gemini: a Google AI Studio key (aistudio.google.com > Get API key). Free tier works.
GEMINI_API_KEY=

# --summarizer claude: alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=
