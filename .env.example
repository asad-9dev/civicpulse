# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed, so no secrets here.
# In Vercel, paste each value as plain text: no quotes, no Markdown link formatting.

# Supabase project that stores newsletter subscribers (see backend/schema.sql).
NEXT_PUBLIC_SUPABASE_URL="https://oqewafmwfkgrnwavmtng.supabase.co"
# Supabase dashboard > Project Settings > API Keys > secret key. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Welcome emails over SMTP (any provider). Leave blank to skip emails; sign-ups still work.
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
#   Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465  SMTP_USER=resend         SMTP_PASS=<re_... API key>
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Sender shown to subscribers, e.g. "CivicPulse <you@gmail.com>". Defaults to SMTP_USER.
EMAIL_FROM=""

# Public address used in email links. Defaults to the address the request came in on.
SITE_URL="https://ddsb-civicpulse.vercel.app"
# Optional: separate key for signing unsubscribe links (defaults to one derived from the Supabase key).
UNSUBSCRIBE_SECRET=""

# Shared secret Vercel Cron sends to /api/digest (Authorization: Bearer ...). Any long random string.
CRON_SECRET=""

# Google Gemini key, used by /api/search to embed search phrases. Same key as backend/.env.
GEMINI_API_KEY=""
